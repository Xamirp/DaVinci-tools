@echo off
cd /d "%~dp0"

echo ============================================================
echo   ?????? ??????????? BitMaker.exe (PyInstaller)
echo ============================================================

if exist "%~dp0.venv\Scripts\pyinstaller.exe" (
    "%~dp0.venv\Scripts\pyinstaller.exe" --noconfirm "%~dp0BitMaker.spec"
) else (
    pyinstaller --noconfirm "%~dp0BitMaker.spec"
)

if errorlevel 1 (
    echo.
    echo [??????] ?????? ??????????? ? ???????.
    pause
    exit /b 1
)

echo.
echo ??????????? ??????????????? bin (FFmpeg) ? dist/BitMaker/bin...
if not exist "%~dp0dist\BitMaker\bin" mkdir "%~dp0dist\BitMaker\bin"
copy /y "%~dp0bin\ffmpeg.exe" "%~dp0dist\BitMaker\bin\" >nul 2>nul
copy /y "%~dp0bin\ffprobe.exe" "%~dp0dist\BitMaker\bin\" >nul 2>nul
copy /y "%~dp0LICENSE" "%~dp0dist\BitMaker\" >nul 2>nul
copy /y "%~dp0README.md" "%~dp0dist\BitMaker\" >nul 2>nul

echo.
echo [?????] ?????? ?????? ? ?????: dist\BitMaker\
echo ??????????? ????: dist\BitMaker\BitMaker.exe
echo.
pause
